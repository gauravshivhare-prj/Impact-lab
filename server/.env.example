# Copy to .env (same folder) and fill in locally. Never commit .env.
NODE_ENV=development
PORT=5000

# Browser origin(s) allowed by CORS, comma-separated. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# Number of trusted reverse-proxy hops when deployed behind a proxy (e.g. 1). Leave empty locally.
TRUST_PROXY=

# Internal Python risk-screening engine (engine/). Express proxies GET /api/v1/risk to it.
ENGINE_URL=http://127.0.0.1:8000
