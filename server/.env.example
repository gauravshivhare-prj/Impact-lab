# Copy to server/.env and fill in locally. Never commit server/.env.
NODE_ENV=development
PORT=5000

# Optional: only needed if MongoDB persistence is enabled.
MONGODB_URI=mongodb://127.0.0.1:27017/ghatwatch

# Server-side only. Never expose these to the React/Vite client.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Browser origin allowed by CORS. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# Set to the number of trusted reverse-proxy hops when deployed behind a proxy (e.g. 1). Leave empty locally.
TRUST_PROXY=
