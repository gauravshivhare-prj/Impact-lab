# Copy to .env (same folder) and fill in locally. Never commit .env.
NODE_ENV=development
PORT=5000

# Browser origin(s) allowed by CORS, comma-separated. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# Server-side only. Never put these in the React/Vite client.
# Leave empty to serve deterministic template briefs without AI.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_TIMEOUT_MS=20000

# Number of trusted reverse-proxy hops when deployed behind a proxy (e.g. 1). Leave empty locally.
TRUST_PROXY=

# Not used yet: the API serves a validated in-memory dataset (see README).
MONGODB_URI=
